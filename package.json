{
  "name": "dsh-mobile-use",
  "version": "0.1.0",
  "description": "Mobile use for DeepSeek Harness: iOS/Android device tools plus a live Simulator mirror in the right Sidebar.",
  "type": "module",
  "license": "MIT",
  "author": "Gustavo Costa",
  "keywords": [
    "deepseek",
    "dsh",
    "mobile-use",
    "ios-simulator",
    "android",
    "mirror",
    "sidebar",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guhcostan/dsh-mobile-use.git"
  },
  "bugs": {
    "url": "https://github.com/guhcostan/dsh-mobile-use/issues"
  },
  "homepage": "https://github.com/guhcostan/dsh-mobile-use#readme",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/check.sh",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  }
}
